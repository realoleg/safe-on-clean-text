# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# macOS
.DS_Store

# Jupyter
.ipynb_checkpoints/

# Encoder training checkpoints (each run deletes its own after predicting)
results/checkpoints/

# Local tool caches
.pytest_cache/
.ruff_cache/

# Keys
.env

# Dreaddit splits with post text: regenerated by `safe-on-clean-text prepare` (ids in data/manifests/dreaddit.csv,
# SHA-256 in data/manifests/checksums.sha256)
data/processed/dreaddit/train.csv
data/processed/dreaddit/validation.csv
data/processed/dreaddit/calibration.csv
data/processed/dreaddit/test.csv

# Degraded condition texts: regenerated by `safe-on-clean-text prepare` (SHA-256 in conditions_report.csv)
data/processed/dreaddit/conditions.csv

# Per-replicate tables (parquet); only aggregates in results/evaluation/*/*.csv are committed
results/evaluation/*/long/
results/evaluation/*/groups/
results/evaluation/*/*_long.parquet
results/evaluation/*/mechanisms/raw/

# Logs of detached long runs (nohup)
logs/

# NLTK punkt_tab for sentence occlusion (downloaded by the encoder runs; URL and SHA-256 in configs/dreaddit.yaml)
data/nltk/

# SDCNL: no license file, so the data is never committed; downloaded by `safe-on-clean-text prepare`
data/raw/sdcnl_combined-set.csv
data/processed/sdcnl/train.csv
data/processed/sdcnl/validation.csv
data/processed/sdcnl/calibration.csv
data/processed/sdcnl/test.csv
data/processed/sdcnl/conditions.csv
